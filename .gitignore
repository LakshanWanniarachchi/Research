# ---------------------------------------------------------------------------
# Datasets  -  too big for git, and reproducible
# ---------------------------------------------------------------------------
# X.npy alone is 58 MB and ptbxl_leadI.npz is 22 MB. Both are rebuilt in a few
# minutes by:   python 1_make_dataset.py  &&  python 3_export_for_colab.py
# The Colab copy lives in Google Drive (MyDrive/ecg_project/).
data/
*.npy
*.npz

# The raw PTB-XL download (~2 GB). It normally sits one folder above this
# project, but this rule protects against it being copied inside by mistake.
ptb-xl-a-large-publicly-available-electrocardiography-dataset-*/
*.zip

# ---------------------------------------------------------------------------
# Trained models  -  regenerated by training, kept in Google Drive
# ---------------------------------------------------------------------------
# ~2.9 MB each. Committing every retrain would grow the repository forever,
# so the models stay in MyDrive/ecg_project/outputs/ instead.
# NOTE: the small JSON configs ARE tracked - they record the thresholds and
# test AUC each model was released with, which is worth keeping in history.
*.keras
*.h5
*.tflite

# Training results (figures, metrics, raw predictions)
outputs/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Jupyter / Colab
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
instance/
*.log

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------------------
# Operating system / OneDrive
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
