# Copy to .env and fill in. .env is never committed.
#
# The broker accounts are created with mosquitto_passwd, see
# mosquitto/mosquitto.windows.conf:
#   mosquitto_passwd -c mosquitto/passwd ecg-server
#   mosquitto_passwd    mosquitto/passwd esp32-001

# Flask session signing key. Without it, sessions end at every restart.
#   python -c "import secrets; print(secrets.token_hex(32))"
ECG_SECRET_KEY=

# Password for the first-run admin account (optional; one is generated if unset)
ECG_ADMIN_PASSWORD=

# --- MQTT transport -------------------------------------------------------
MQTT_ENABLED=1
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=ecg-server
MQTT_PASSWORD=
MQTT_CLIENT_ID=ecg-server

# TLS for anything beyond a trusted local network (broker must listen on 8883)
MQTT_TLS=0
MQTT_CA_CERT=

# Refuse a reading whose device token does not match the registered device
REQUIRE_DEVICE_TOKEN=0

# --- Application ----------------------------------------------------------
ECG_LIVE_DEVICE_ID=ESP32-001
ECG_HOST=127.0.0.1
ECG_PORT=5000
